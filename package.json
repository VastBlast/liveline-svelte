{
  "name": "liveline-svelte",
  "version": "0.0.2",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "description": "Independent real-time chart library for Svelte 5, with animated line, candlestick, and multi-series modes. Originally forked from Liveline.",
  "keywords": [
    "svelte",
    "chart",
    "canvas",
    "real-time",
    "animation",
    "line-chart",
    "candlestick",
    "ohlc",
    "multi-series",
    "multi-line"
  ],
  "license": "MIT",
  "author": "VastBlast",
  "contributors": [
    "Benji Taylor (original Liveline project)",
    "VastBlast (independent Svelte library development and maintenance)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VastBlast/liveline-svelte.git"
  },
  "homepage": "https://github.com/VastBlast/liveline-svelte#readme",
  "bugs": "https://github.com/VastBlast/liveline-svelte/issues",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "src/lib",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm build:site && pnpm package",
    "build:site": "vite build",
    "dev": "vite dev",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "package": "svelte-kit sync && svelte-package",
    "prepack": "pnpm package",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:types": "svelte-kit sync && svelte-check --config ./vite.config.ts --tsconfig ./tsconfig.json",
    "check:lint": "oxlint",
    "check": "pnpm check:types && pnpm check:lint",
    "prepublishOnly": "pnpm check && pnpm test"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.20.1",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
